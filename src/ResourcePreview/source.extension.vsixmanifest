<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <!-- Never change the Id: Visual Studio uses it to recognize updates. -->
    <Identity Id="ResourcePreview.AF4A88FA-261D-43BF-8243-982B85C621CC" Version="1.5.0" Language="en-US" Publisher="Herbert Nijkamp" />
    <DisplayName>XAML Resource Preview</DisplayName>
    <Description xml:space="preserve">See your XAML resources without leaving the editor. Hover over a StaticResource or DynamicResource for a picture of icons, brushes and images, a setter table with a live sample for styles, and an element tree for templates. See which definition WPF uses, catch missing, overridden and unused keys in the Error List, rename keys, extract values and attributes to resources and styles, find an existing resource that fits, see color swatches in the code, and browse all resources in the XAML Resources window.</Description>
    <Icon>Assets\icon.png</Icon>
    <PreviewImage>Assets\preview.png</PreviewImage>
    <Tags>xaml, wpf, resource, resourcedictionary, staticresource, dynamicresource, preview, quick info, style, icon, geometry, refactoring, rename, color</Tags>
  </Metadata>
  <Installation>
    <!-- 17.14 is the first version with the Unified Settings API used by the options page. -->
    <InstallationTarget Id="Microsoft.VisualStudio.Community" Version="[17.14,19.0)">
      <ProductArchitecture>amd64</ProductArchitecture>
    </InstallationTarget>
    <InstallationTarget Id="Microsoft.VisualStudio.Community" Version="[17.14,19.0)">
      <ProductArchitecture>arm64</ProductArchitecture>
    </InstallationTarget>
  </Installation>
  <Prerequisites>
    <Prerequisite Id="Microsoft.VisualStudio.Component.CoreEditor" Version="[17.14,)" DisplayName="Visual Studio core editor" />
  </Prerequisites>
  <Assets>
    <Asset Type="Microsoft.VisualStudio.MefComponent" d:Source="Project" d:ProjectName="%CurrentProject%" Path="|%CurrentProject%|" />
    <Asset Type="Microsoft.VisualStudio.VsPackage" d:Source="Project" d:ProjectName="%CurrentProject%" Path="|%CurrentProject%;PkgdefProjectOutputGroup|" />
  </Assets>
</PackageManifest>
