<?xml version="1.0" encoding="utf-8"?>
<CommandTable xmlns="http://schemas.microsoft.com/VisualStudio/2005-10-18/CommandTable" xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <Extern href="stdidcmd.h" />
  <Extern href="vsshlids.h" />

  <Commands package="guidResourcePreviewPackage">
    <Groups>
      <!-- The context menu of the XAML text editor. -->
      <Group guid="guidResourcePreviewCmdSet" id="EditorContextGroup" priority="0x0100">
        <Parent guid="guidXamlUiCmds" id="IDM_XAML_EDITOR" />
      </Group>
    </Groups>

    <Buttons>
      <!-- Hidden until the package shows it: only when the caret is on a resource reference. The text is set in code so it can be translated. -->
      <Button guid="guidResourcePreviewCmdSet" id="cmdidGoToResourceDefinition" priority="0x0100" type="Button">
        <Parent guid="guidResourcePreviewCmdSet" id="EditorContextGroup" />
        <CommandFlag>DynamicVisibility</CommandFlag>
        <CommandFlag>DefaultInvisible</CommandFlag>
        <CommandFlag>TextChanges</CommandFlag>
        <Strings>
          <ButtonText>Go To Resource Definition</ButtonText>
          <CanonicalName>.ResourcePreview.GoToResourceDefinition</CanonicalName>
          <LocCanonicalName>.ResourcePreview.GoToResourceDefinition</LocCanonicalName>
        </Strings>
      </Button>

      <!-- Also hidden until the package shows it: on a reference or on an x:Key. -->
      <Button guid="guidResourcePreviewCmdSet" id="cmdidFindResourceReferences" priority="0x0101" type="Button">
        <Parent guid="guidResourcePreviewCmdSet" id="EditorContextGroup" />
        <CommandFlag>DynamicVisibility</CommandFlag>
        <CommandFlag>DefaultInvisible</CommandFlag>
        <CommandFlag>TextChanges</CommandFlag>
        <Strings>
          <ButtonText>Find Resource References</ButtonText>
          <CanonicalName>.ResourcePreview.FindResourceReferences</CanonicalName>
          <LocCanonicalName>.ResourcePreview.FindResourceReferences</LocCanonicalName>
        </Strings>
      </Button>

      <!-- No default shortcut: Ctrl+R, Ctrl+R belongs to the rename of the code editor. Assign one under Tools > Options > Keyboard. -->
      <Button guid="guidResourcePreviewCmdSet" id="cmdidRenameResourceKey" priority="0x0102" type="Button">
        <Parent guid="guidResourcePreviewCmdSet" id="EditorContextGroup" />
        <CommandFlag>DynamicVisibility</CommandFlag>
        <CommandFlag>DefaultInvisible</CommandFlag>
        <CommandFlag>TextChanges</CommandFlag>
        <Strings>
          <ButtonText>Rename Resource Key...</ButtonText>
          <CanonicalName>.ResourcePreview.RenameResourceKey</CanonicalName>
          <LocCanonicalName>.ResourcePreview.RenameResourceKey</LocCanonicalName>
        </Strings>
      </Button>

      <!-- The light bulb actions (Ctrl+.) also in the menu. Each shows only when it applies. -->
      <Button guid="guidResourcePreviewCmdSet" id="cmdidExtractToResource" priority="0x0103" type="Button">
        <Parent guid="guidResourcePreviewCmdSet" id="EditorContextGroup" />
        <CommandFlag>DynamicVisibility</CommandFlag>
        <CommandFlag>DefaultInvisible</CommandFlag>
        <CommandFlag>TextChanges</CommandFlag>
        <Strings>
          <ButtonText>Extract to Resource...</ButtonText>
          <CanonicalName>.ResourcePreview.ExtractToResource</CanonicalName>
          <LocCanonicalName>.ResourcePreview.ExtractToResource</LocCanonicalName>
        </Strings>
      </Button>
      <Button guid="guidResourcePreviewCmdSet" id="cmdidExtractToStyle" priority="0x0104" type="Button">
        <Parent guid="guidResourcePreviewCmdSet" id="EditorContextGroup" />
        <CommandFlag>DynamicVisibility</CommandFlag>
        <CommandFlag>DefaultInvisible</CommandFlag>
        <CommandFlag>TextChanges</CommandFlag>
        <Strings>
          <ButtonText>Extract to Style...</ButtonText>
          <CanonicalName>.ResourcePreview.ExtractToStyle</CanonicalName>
          <LocCanonicalName>.ResourcePreview.ExtractToStyle</LocCanonicalName>
        </Strings>
      </Button>
      <Button guid="guidResourcePreviewCmdSet" id="cmdidAddToStyle" priority="0x0105" type="Button">
        <Parent guid="guidResourcePreviewCmdSet" id="EditorContextGroup" />
        <CommandFlag>DynamicVisibility</CommandFlag>
        <CommandFlag>DefaultInvisible</CommandFlag>
        <CommandFlag>TextChanges</CommandFlag>
        <Strings>
          <ButtonText>Add to Existing Style</ButtonText>
          <CanonicalName>.ResourcePreview.AddToStyle</CanonicalName>
          <LocCanonicalName>.ResourcePreview.AddToStyle</LocCanonicalName>
        </Strings>
      </Button>
      <Button guid="guidResourcePreviewCmdSet" id="cmdidFindMatchingResource" priority="0x0106" type="Button">
        <Parent guid="guidResourcePreviewCmdSet" id="EditorContextGroup" />
        <CommandFlag>DynamicVisibility</CommandFlag>
        <CommandFlag>DefaultInvisible</CommandFlag>
        <CommandFlag>TextChanges</CommandFlag>
        <Strings>
          <ButtonText>Find Matching Resource...</ButtonText>
          <CanonicalName>.ResourcePreview.FindMatchingResource</CanonicalName>
          <LocCanonicalName>.ResourcePreview.FindMatchingResource</LocCanonicalName>
        </Strings>
      </Button>
      <!-- View > Other Windows > XAML Resources. Always visible, so VS loads the package when it is clicked. -->
      <Button guid="guidResourcePreviewCmdSet" id="cmdidOpenResourcesWindow" priority="0x0100" type="Button">
        <Parent guid="guidSHLMainMenu" id="IDG_VS_WNDO_OTRWNDWS1" />
        <CommandFlag>TextChanges</CommandFlag>
        <Strings>
          <ButtonText>XAML Resources</ButtonText>
          <CanonicalName>.View.XamlResources</CanonicalName>
          <LocCanonicalName>.View.XamlResources</LocCanonicalName>
        </Strings>
      </Button>
    </Buttons>
  </Commands>

  <!-- Also in the code editor context menu, for .xaml files that open in the XML editor. -->
  <CommandPlacements>
    <CommandPlacement guid="guidResourcePreviewCmdSet" id="EditorContextGroup" priority="0x0100">
      <Parent guid="guidSHLMainMenu" id="IDM_VS_CTXT_CODEWIN" />
    </CommandPlacement>
  </CommandPlacements>

  <!-- Text Editor scope, not Global: VS binds Ctrl+Alt+F12 globally to Edit.FindSymbol, and a scoped binding wins inside an editor. -->
  <KeyBindings>
    <KeyBinding guid="guidResourcePreviewCmdSet" id="cmdidGoToResourceDefinition" editor="guidTextEditorScope" key1="VK_F12" mod1="Control Alt" />
    <KeyBinding guid="guidResourcePreviewCmdSet" id="cmdidFindResourceReferences" editor="guidTextEditorScope" key1="VK_F12" mod1="Shift Alt" />
  </KeyBindings>

  <Symbols>
    <GuidSymbol name="guidResourcePreviewPackage" value="{69e55270-ef51-4488-9e95-cfd1a6852056}" />

    <GuidSymbol name="guidResourcePreviewCmdSet" value="{49b12957-db89-4dfc-b79d-a9d1c46f0a5f}">
      <IDSymbol name="EditorContextGroup" value="0x1020" />
      <IDSymbol name="cmdidGoToResourceDefinition" value="0x0100" />
      <IDSymbol name="cmdidFindResourceReferences" value="0x0101" />
      <IDSymbol name="cmdidRenameResourceKey" value="0x0102" />
      <IDSymbol name="cmdidExtractToResource" value="0x0103" />
      <IDSymbol name="cmdidExtractToStyle" value="0x0104" />
      <IDSymbol name="cmdidAddToStyle" value="0x0105" />
      <IDSymbol name="cmdidFindMatchingResource" value="0x0106" />
      <IDSymbol name="cmdidOpenResourcesWindow" value="0x0107" />
    </GuidSymbol>

    <!-- Key binding scope "Text Editor" in Tools > Options > Keyboard. -->
    <GuidSymbol name="guidTextEditorScope" value="{8B382828-6202-11d1-8870-0000F87579D2}" />

    <!-- Menus of the WPF XAML editor (the same IDs XAML Styler uses). -->
    <GuidSymbol name="guidXamlUiCmds" value="{4c87b692-1202-46aa-b64c-ef01faec53da}">
      <IDSymbol name="IDM_XAML_EDITOR" value="0x0103" />
    </GuidSymbol>
  </Symbols>
</CommandTable>
