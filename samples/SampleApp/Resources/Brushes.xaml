<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Used from Icons.xaml: tests a dependency in another file. -->
    <SolidColorBrush x:Key="AccentBrush" Color="#FF002BBD" />
    <SolidColorBrush x:Key="WarningBrush" Color="#FFE8A317" />

    <!-- Also in Values.xaml. App.xaml merges Values.xaml later, so WPF never uses this one (blue). -->
    <SolidColorBrush x:Key="InfoBrush" Color="#FF1E88E5" />

    <!-- Nothing uses this one: the Error List shows it as unused. -->
    <SolidColorBrush x:Key="UnusedBrush" Color="#FF9E9E9E" />

    <!-- Only used from code (MainWindow.xaml.cs), so it does not count as unused. -->
    <SolidColorBrush x:Key="CodeOnlyBrush" Color="#FF6A1B9A" />

</ResourceDictionary>
