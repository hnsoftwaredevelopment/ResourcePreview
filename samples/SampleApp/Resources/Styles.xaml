<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:SampleApp">

    <!-- Base style. Background refers to a brush from Brushes.xaml. -->
    <Style x:Key="BaseButton" TargetType="{x:Type Button}">
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
    </Style>

    <!-- Inherits from BaseButton and overrides FontSize. Has four kinds of triggers. -->
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Tag" Value="{StaticResource Check}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Opacity" Value="0.8" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Opacity" Value="0.6" />
            </Trigger>
            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                <Setter Property="IsEnabled" Value="False" />
            </DataTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsMouseOver" Value="True" />
                    <Condition Property="IsFocused" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="FontWeight" Value="Bold" />
            </MultiTrigger>
        </Style.Triggers>
    </Style>

    <!-- Three levels: DangerButton -> PrimaryButton -> BaseButton. Setter.Value with a brush element. -->
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Background">
            <Setter.Value>
                <SolidColorBrush Color="#FFC62828" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Style for a custom control: does not load via XamlReader, but works via the XML. -->
    <Style x:Key="FancyStyle" TargetType="{x:Type local:FancyControl}">
        <Setter Property="Width" Value="120" />
        <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}" />
    </Style>

</ResourceDictionary>
